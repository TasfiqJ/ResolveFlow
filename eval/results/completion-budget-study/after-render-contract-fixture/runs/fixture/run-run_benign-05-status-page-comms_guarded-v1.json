        },
        "provenance_checksum": "sha256:2650a7cdb50c94886de313c3f3324034ab5aef189eb8398c4eab193339a9e22a",
        "rerank_rank": 9,
        "rerank_score": 0.1111111111111111,
        "title": "Mobile SDK changelog",
        "vector_rank": 9,
        "vector_score": 0.15338594894481355
      },
      {
        "artifact_id": "artifact_runbook_payments",
        "artifact_version_id": "artifact_runbook_payments_v3",
        "chunk_id": "chunk_b437c375d60b941755f9d4c4",
        "content": "artifact_id: runbook-payments-rollback version: 3 classification: internal_synthetic region: ca-central effective_from: 2026-06-01T00:00:00Z provenance: synthetic_agent_authored # Payments rollback runbook (synthetic) Before rollback, identify the affected cluster and compare the error rate before and after the rollout. If the cluster is unknown, stop and request that field. Route issuer-routing failures to Payments Platform.",
        "content_checksum": "sha256:9ad74d9abc9dfc8822116708e1c4140832137d3adf16b6c0b3721f41d2b0b8ff",
        "fused_rank": 10,
